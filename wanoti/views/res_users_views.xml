<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_wanoti_phone" model="ir.ui.view">
        <field name="name">res.users.form.wanoti.phone</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group name="wanoti_phone_numbers">
                    <field name="phone" widget="wanoti_phone"/>
                    <field name="mobile" widget="wanoti_phone"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_wanoti_phone" model="ir.ui.view">
        <field name="name">res.users.preferences.form.wanoti.phone</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']//field[@name='email']" position="after">
                <field name="phone" widget="wanoti_phone"/>
                <field name="mobile" widget="wanoti_phone"/>
            </xpath>
        </field>
    </record>
</odoo>
